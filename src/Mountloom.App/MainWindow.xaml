<Window x:Class="Mountloom.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mountloom" Height="700" Width="980" MinHeight="540" MinWidth="780"
        Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed" StateChanged="Window_StateChanged">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center" /></Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30" /><Setter Property="Margin" Value="0,4,0,10" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="PasswordBox"><Setter Property="MinHeight" Value="30" /><Setter Property="Margin" Value="0,4,0,10" /></Style>
        <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="30" /><Setter Property="Margin" Value="0,4,0,10" /></Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,8,6" />
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,4,16,10" /></Style>
        <Style TargetType="Expander"><Setter Property="Margin" Value="0,8,0,6" /></Style>
    </Window.Resources>
    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Background="White" Padding="18,12" BorderBrush="#DEE5EF" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="退出并卸载" Click="Exit_Click" Margin="12,0,0,0" />
                <TextBlock x:Name="SaveStatusText" DockPanel.Dock="Right" Text="正在加载配置…" Foreground="#5D6B82" />
                <StackPanel><TextBlock Text="Mountloom" FontSize="24" FontWeight="SemiBold" Foreground="#172033" />
                    <TextBlock Text="连接远程存储，像本地磁盘一样使用" Foreground="#5D6B82" Margin="0,3,0,0" /></StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="18">
            <Border Background="White" BorderBrush="#DEE5EF" BorderThickness="1" CornerRadius="8" Padding="14">
                <ScrollViewer x:Name="ConnectionsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid MinHeight="{Binding ViewportHeight, ElementName=ConnectionsScrollViewer}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="AddButton" Content="新建连接" Click="Add_Click" /><Button x:Name="DeleteButton" Content="删除" Click="Delete_Click" />
                        </StackPanel>
                        <TextBlock Text="我的连接" FontSize="18" FontWeight="SemiBold" />
                    </DockPanel>
                    <DataGrid x:Name="ConnectionsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionChanged="ConnectionsGrid_SelectionChanged" HeadersVisibility="Column"
                              MouseDoubleClick="ConnectionsGrid_MouseDoubleClick" PreviewKeyDown="ConnectionsGrid_PreviewKeyDown"
                              CanUserAddRows="False" GridLinesVisibility="Horizontal" RowHeaderWidth="0" MinHeight="100" MaxHeight="440">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="名称" Width="*" MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="6,6" VerticalAlignment="Center">
                                            <Hyperlink Click="EditConnection_Click" Tag="{Binding}" ToolTip="打开连接设置"><Run Text="{Binding Name, Mode=OneWay}" /></Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="70" />
                            <DataGridTextColumn Header="盘符" Binding="{Binding DriveLetter}" Width="50" />
                            <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="75" />
                            <DataGridCheckBoxColumn Header="自动" Binding="{Binding AutoMount, Mode=OneWay}" Width="45" />
                            <DataGridTextColumn Header="最近错误" Binding="{Binding LastError}" Width="*" MinWidth="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                        <Button x:Name="EditConnectionButton" Content="连接设置" Click="EditSelectedConnection_Click" />
                        <Button x:Name="MountButton" Content="挂载" Click="Mount_Click" />
                        <Button x:Name="UnmountButton" Content="卸载" Click="Unmount_Click" />
                        <Button x:Name="ReconnectButton" Content="重新挂载" Click="Reconnect_Click" />
                        <Button x:Name="TestConnectionButton" Content="测试连接" Click="TestConnection_Click" />
                        <Button x:Name="CancelOperationButton" Content="取消操作" Click="CancelOperation_Click" />
                        <Button x:Name="OpenDriveButton" Content="打开盘符" Click="OpenDrive_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="ConnectionStatusText" Grid.Row="3" TextWrapping="Wrap" Foreground="#5D6B82" MaxHeight="80" Margin="0,2,0,4" />
                    <TextBlock x:Name="DependencySummaryText" Grid.Row="4" Text="启动后将自动准备所需组件。" TextWrapping="Wrap" Foreground="#5D6B82" Margin="0,2,0,4" />
                    <Expander Grid.Row="5" Header="应用设置与环境" x:Name="ApplicationSettingsPanel">
                        <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,10,0,0">
                                <CheckBox x:Name="MinimizeToTrayBox" Content="关闭或最小化窗口时留在托盘，保持挂载" />
                                <CheckBox x:Name="StartWithWindowsBox" Content="登录 Windows 时启动 Mountloom" Checked="StartWithWindowsBox_Changed" Unchecked="StartWithWindowsBox_Changed" />
                                <WrapPanel>
                                    <Button x:Name="DetectButton" Content="重新检查 / 修复" Click="DetectEnvironment_Click" />
                                    <Button x:Name="InstallWinFspButton" Content="安装 WinFsp" Click="InstallWinFsp_Click" />
                                </WrapPanel>
                                <TextBlock Text="所需组件由 Mountloom 自动准备，无需指定程序路径。" TextWrapping="Wrap" Foreground="#5D6B82" Margin="0,4,0,4" />
                                <TextBlock x:Name="EnvironmentText" Text="启动后自动检查组件…" TextWrapping="Wrap" Foreground="#38465A" Margin="0,4,0,8" />
                                <TextBlock TextWrapping="Wrap" Foreground="#5D6B82" Margin="0,4,0,8">
                                    <Run Text="WinFsp - Windows File System Proxy, Copyright (C) Bill Zissimopoulos" />
                                    <LineBreak />
                                    <Hyperlink NavigateUri="https://github.com/winfsp/winfsp" Click="OpenWinFspProject_Click" ToolTip="打开 WinFsp 官方项目">https://github.com/winfsp/winfsp</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>
                    </Expander>
                </Grid>
                </ScrollViewer>
            </Border>

        </Grid>
        <Border Grid.Row="2" Margin="18,0,18,18" Background="White" BorderBrush="#DEE5EF" BorderThickness="1" CornerRadius="8" Padding="12,4">
            <Expander x:Name="LogsExpander" Header="日志" IsExpanded="False" Foreground="#172033" Margin="0,4">
                <Grid Margin="0,10,0,4">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="155" /></Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="复制" Click="CopyLogs_Click" /><Button Content="导出" Click="ExportLogs_Click" /><Button Content="清空显示" Click="ClearLogs_Click" />
                        </StackPanel>
                        <ComboBox x:Name="LogFilterBox" DisplayMemberPath="Name" SelectionChanged="LogFilterBox_SelectionChanged" Width="210" HorizontalAlignment="Left" Margin="0,0,0,6" />
                    </DockPanel>
                    <Border Grid.Row="1" Background="#172033" CornerRadius="4" Padding="8">
                        <TextBox x:Name="LogBox" FontFamily="Consolas" FontSize="12" Foreground="#DCE7F7" Background="#172033"
                                 BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="0" />
                    </Border>
                </Grid>
            </Expander>
        </Border>
    </Grid>
</Window>
